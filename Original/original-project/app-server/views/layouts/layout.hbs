<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="author" content="Alysha Pursley">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    {{!-- Shared styles load first; pageStyle is included only when a page owns unique rules. --}}
    <link rel="stylesheet" href="/css/shared.css">
    {{#if pageStyle}}
      <link rel="stylesheet" href="/css/{{pageStyle}}.css">
    {{/if}}
  </head>
  <body>
    <div id="background">
      <div id="page">
        {{{body}}}
      </div>
    </div>
  </body>
</html>
