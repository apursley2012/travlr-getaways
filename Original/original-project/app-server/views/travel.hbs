{{> header}}

<main id="contents">
  <div class="box">
    <div>
      <div class="body">
        <h1>Travel</h1>
        {{#if message}}<p>{{message}}</p>{{/if}}
        <ul id="sites">
          {{#each trips}}
            <li>
              <img src="/images/{{this.image}}" alt="{{this.name}}">
              <h2>{{this.name}}</h2>
              {{!-- Trip descriptions are stored as trusted formatted project content. --}}
              <p>{{{this.description}}}</p>
            </li>
          {{/each}}
        </ul>
      </div>
    </div>
  </div>
</main>

{{> footer}}
