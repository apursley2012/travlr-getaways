#!/usr/bin/env node
/*                                                                              
 *******************************************************************************
 * Travlr Getaways                                                             *
 * File: /www                                                                  *
 * Purpose: Creates the HTTP server, validates the configured port, and        *
 *          reports startup and listening errors.                              *
 * Author: Alysha Pursley                                                      *
 * Copyright: (c) 2026 Alysha Pursley.                                         *
 * License: Proprietary; see LICENSE                                           *
 *******************************************************************************
*/                                                                              

const app = require("../app");
const debug = require("debug")("travlr:server");
const http = require("http");
const database = require("../app-api/models/db");

const normalizePort = (value) => {
  const parsedPort = Number.parseInt(value, 10);

  if (Number.isNaN(parsedPort)) {
    return value;
  }

  return parsedPort >= 0 ? parsedPort : false;
};

const port = normalizePort(process.env.PORT || "3000");
app.set("port", port);

const server = http.createServer(app);

const onError = (error) => {
  if (error.syscall !== "listen") {
    throw error;
  }

  const bind = typeof port === "string" ? `Pipe ${port}` : `Port ${port}`;

  if (error.code === "EACCES") {
    console.error(`${bind} requires elevated privileges.`);
    process.exit(1);
  }

  if (error.code === "EADDRINUSE") {
    console.error(`${bind} is already in use.`);
    process.exit(1);
  }

  throw error;
};

const onListening = () => {
  const address = server.address();
  const bind =
    typeof address === "string" ? `pipe ${address}` : `port ${address.port}`;

  debug(`Listening on ${bind}`);
};

server.on("error", onError);
server.on("listening", onListening);

let shuttingDown = false;
const shutdown = (signal) => {
  if (shuttingDown) return;
  shuttingDown = true;
  // Stop new requests, then release MongoDB after in-flight HTTP work completes.
  const forceClose = setTimeout(() => server.closeAllConnections(), 10000);
  forceClose.unref();
  server.close(async (error) => {
    clearTimeout(forceClose);
    if (error && error.code !== "ERR_SERVER_NOT_RUNNING") {
      console.error("HTTP shutdown failed:", error.message);
      process.exitCode = 1;
    }
    try {
      await database.closeForShutdown();
    } catch (dbError) {
      console.error("MongoDB shutdown failed:", dbError.message);
      process.exitCode = 1;
    }
    if (signal === "SIGUSR2") {
      process.removeAllListeners("SIGUSR2");
      process.kill(process.pid, "SIGUSR2");
    }
  });
};

for (const signal of ["SIGINT", "SIGTERM", "SIGUSR2"]) {
  process.once(signal, () => shutdown(signal));
}

// Do not accept traffic until the required database connection is available.
database.readyPromise
  .then(() => server.listen(port))
  .catch(() => {
    console.error("Startup aborted: MongoDB is unavailable.");
    process.exitCode = 1;
  });
